<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Com.Kingdee.App.Views.CalculatePage"
             Title="CalculatePage">
    <ContentPage.Resources>
        <Style TargetType="Button">
            <Setter Property="HeightRequest" Value="75"></Setter>
            <Setter Property="WidthRequest" Value="75"></Setter>
            <Setter Property="BackgroundColor" Value="Gray"></Setter>
            <Setter Property="TextColor" Value="Black"></Setter>
        </Style>
        <Style TargetType="Grid">
            <Setter Property="VerticalOptions" Value="Center"></Setter>
            <Setter Property="HorizontalOptions" Value="Center"></Setter>
            <Setter Property="RowSpacing" Value="5"></Setter>
            <Setter Property="ColumnSpacing" Value="10"></Setter>
        </Style>

    </ContentPage.Resources>
    <VerticalStackLayout>
        <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,Auto">
            <Label Text="历史结果" HeightRequest="150" WidthRequest="150" Grid.Row="0" Grid.Column="0"></Label>
            <Label Text="当前计算" HeightRequest="150" WidthRequest="150" Grid.Row="0" Grid.Column="1"></Label>
        </Grid>
        <Grid RowDefinitions="*,*,*,*,Auto"
              ColumnDefinitions="*,*,*,Auto"
        >
            <Button Text="Clear" Grid.Column="0" Grid.Row="0"/>
            <Button Text="=" Grid.Column="1" Grid.Row="0" />
            <Button Text="/" Grid.Column="2" Grid.Row="0" />
            <Button  Text="*" Grid.Column="3" Grid.Row="0" />
            <Button  Text="7" Grid.Column="0" Grid.Row="1" />
            <Button  Text="8" Grid.Column="1" Grid.Row="1" />
            <Button  Text="9" Grid.Column="2" Grid.Row="1" />
            <Button  Text="-" Grid.Column="3" Grid.Row="1" />
            <Button  Text="4" Grid.Column="0" Grid.Row="2" />
            <Button  Text="5" Grid.Column="1" Grid.Row="2"/>
            <Button Text="6" Grid.Column="2" Grid.Row="2" />
            <Button  Text="+" Grid.Column="3" Grid.Row="2" />
            <Button  Text="1" Grid.Column="0" Grid.Row="3"/>
            <Button  Text="2" Grid.Column="1" Grid.Row="3"/>
            <Button  Text="3" Grid.Column="2" Grid.Row="3" />
            <Button  HeightRequest="167" Text="Enter" Grid.Column="3" Grid.RowSpan="2" Grid.Row="3"/>
            <Button WidthRequest="175"  Text="0" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="4" />
            <Button  Text="." VerticalOptions="Center" HorizontalOptions="Center" Grid.Column="2" Grid.Row="4" />
        </Grid>
    </VerticalStackLayout>
</ContentPage>